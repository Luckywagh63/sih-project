# MongoDB Atlas Configuration
# Example: mongodb+srv://admin:pass123@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=aicte_workflow

# Security & Authentication
JWT_SECRET=aicte_secure_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Twilio SMS Configuration (optional: if omitted, SMS notifications will be gracefully marked as unconfigured)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Server & CORS
FRONTEND_ORIGIN=http://localhost:3000
